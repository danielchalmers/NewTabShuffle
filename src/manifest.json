{
  "manifest_version": 3,
  "name": "NewTab Shuffle",
  "version": "1.0.0",
  "description": "Randomly display URLs or local files when opening a new tab",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab/index.html"
  },
  "options_page": "options/index.html",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "NewTab Shuffle Options"
  }
}
